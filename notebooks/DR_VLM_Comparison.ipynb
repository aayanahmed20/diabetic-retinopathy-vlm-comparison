   "metadata": {},
   "source": [
    "# Diabetic Retinopathy: Pilot (Mock) run\n",
    "\n",
    "This notebook runs a self-contained pilot (mock) evaluation of three adapters (Gemini, MedGemma, RetiZero) using deterministic mock predictions.\n",
    "It produces: `results/predictions.csv`, `results/metrics.txt`, and `reports/pilot_report.md`.\n",
    "No external keys or weights are required; this is safe to run in CI/Colab/local."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "source": [
    "# Ensure lightweight dependencies are available (pandas, scikit-learn)\n",
    "try:\n",
    "    import pandas as pd\n",
    "    from sklearn.metrics import accuracy_score, cohen_kappa_score, mean_absolute_error\n",
    "except Exception:\n",
    "    import sys, subprocess\n",
    "    subprocess.check_call([sys.executable, '-m', 'pip', 'install', 'pandas', 'scikit-learn'])\n",
    "    import pandas as pd\n",
    "    from sklearn.metrics import accuracy_score, cohen_kappa_score, mean_absolute_error\n",
    "\n",
    "print('Dependencies ready')"
   ],
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "source": [
    "import os\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "\n",
    "# Ensure test metadata exists. If not, create a balanced small CSV (125 rows, 25 per grade).\n",
    "Path('results').mkdir(parents=True, exist_ok=True)\n",
    "Path('reports').mkdir(parents=True, exist_ok=True)\n",
    "if not os.path.exists('tests/test_metadata_subset.csv'):\n",
    "    print('Creating tests/test_metadata_subset.csv (125 balanced samples)')\n",
    "    import csv\n",
    "    ids = [f'id{n:03d}' for n in range(125)]\n",
    "    diagnoses = [g for g in range(5) for _ in range(25)]\n",
    "    image_paths = [f'images/{ids[i]}.png' for i in range(125)]\n",
    "    os.makedirs('tests', exist_ok=True)\n",
    "    with open('tests/test_metadata_subset.csv', 'w', newline='') as f:\n",
    "        writer = csv.writer(f)\n",
    "        writer.writerow(['id_code','image_path','diagnosis'])\n",
    "        for i in range(125):\n",
    "            writer.writerow([ids[i], image_paths[i], diagnoses[i]])\n",
    "else:\n",
    "    print('Found tests/test_metadata_subset.csv')\n",
    "\n",
    "# Load the metadata\n",
    "df = pd.read_csv('tests/test_metadata_subset.csv')\n",
    "print('Loaded', len(df), 'rows')\n",
    "\n",
    "# Deterministic mock predictor (based on id or path)\n",
    "def predict_mock(x, salt: str=''):\n",
    "    if pd.isna(x):\n",
    "        return None\n",
    "    key = str(x) + salt\n",
    "    return abs(hash(key)) % 5\n",
    "\n",
    "# Generate mock predictions for three adapters\n",
    "df['gemini_pred'] = df['id_code'].apply(lambda x: predict_mock(x, salt='gemini'))\n",
    "df['medgemma_pred'] = df['id_code'].apply(lambda x: predict_mock(x, salt='medgemma'))\n",
    "df['retizero_pred'] = df['id_code'].apply(lambda x: predict_mock(x, salt='retizero'))\n",
    "\n",
    "# Save predictions CSV\n",
    "out_path = 'results/predictions.csv'\n",
    "df.to_csv(out_path, index=False)\n",
    "print('Wrote', out_path)\n",
    "\n",
    "# Compute metrics and write pilot report\n",
    "models = ['gemini_pred','medgemma_pred','retizero_pred']\n",
    "lines = []\n",
    "metrics = {}\n",
    "for m in models:\n",
    "    valid = df.dropna(subset=[m,'diagnosis'])\n",
    "    if len(valid) == 0:\n",
    "        lines.append(f"{m}: N=0")\n",
    "        metrics[m] = {'N':0,'Accuracy':None,'QWK':None,'MAE':None}\n",
    "        continue\n",
    "    y_true = valid['diagnosis'].astype(int)\n",
    "    y_pred = valid[m].astype(int)\n",
    "    acc = accuracy_score(y_true, y_pred)\n",
    "    qwk = cohen_kappa_score(y_true, y_pred, weights='quadratic')\n",
    "    mae = mean_absolute_error(y_true, y_pred)\n",
    "    lines.append(f"{m}: N={len(valid)}, Accuracy={acc:.3f}, QWK={qwk:.3f}, MAE={mae:.3f}")\n",
    "    metrics[m] = {'N':len(valid),'Accuracy':round(acc,3),'QWK':round(qwk,3),'MAE':round(mae,3)}\n",
    "\n",
    "# Write metrics to file\n",
    "with open('results/metrics.txt','w') as f:\n",
    "    f.write('\n'.join(lines))\n",
    "print('Wrote results/metrics.txt')\n",
    "\n",
    "# Create a clear pilot report and commit-ready artifacts\n",
    "report_lines = [\n",
    "    '# Pilot (Mock) Evaluation Report\n',\n",
    "    'This report documents a pilot/mock validation run. The predictions were generated using deterministic mock functions to validate the pipeline. These are NOT real model outputs.\n',\n",
    "    'Files produced: results/predictions.csv, results/metrics.txt\n',\n",
    "    '## Summary\n'\n",
    "]\n",
    "for m, stats in metrics.items():\n",
    "    report_lines.append(f"- {m.replace('_pred','')}: N={stats['N']}, Accuracy={stats['Accuracy']}, QWK={stats['QWK']}, MAE={stats['MAE']}\n")\n",
    "report_lines.append('\n## Notes\n- This is a pilot/mock run. Replace with real secrets and weights to obtain production results.\n')\n",
    "with open('reports/pilot_report.md','w') as f:\n",
    "    f.writelines(report_lines)\n",
    "print('Wrote reports/pilot_report.md')\n",
    "\n",
    "# Display summary in notebook\n",
    "from IPython.display import display, Markdown\n",
    "display(Markdown(''.join(report_lines)))\n"
   ],
   "outputs": []
  },
  {
   "cell_type": "markdown",
